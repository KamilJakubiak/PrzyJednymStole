# Response headers for jakubiak.work/przyjednymstole, read by tool-ui's scripts/ship.mjs.
# The same baseline as the rest of jakubiak.work, except that pages may be framed by this
# site itself: the landing page shows the map in an iframe, and the map reaches into its parent.
/przyjednymstole/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), midi=(), serial=()
